{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "settings": {
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 400
        }
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "html-has-lang": "error",
        "image-alt": "error",
        "link-name": "error"
      }
    }
  }
}
