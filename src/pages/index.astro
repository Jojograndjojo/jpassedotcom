<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Jonathan Passe</title>
    <script>
      const prefersFrench = navigator.language.startsWith("fr");
      const target = prefersFrench ? "/fr/" : "/en/";
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p><a href="/en/">English</a> — <a href="/fr/">Français</a></p>
  </body>
</html>
