---
import { getTranslation } from "../lib/i18n";

interface Props {
	locale: string;
	alternateLocale: string;
	alternateUrl: string;
}

const { locale } = Astro.props;
const name = getTranslation(locale, "name");
const identity = getTranslation(locale, "identity");
const emailLabel = getTranslation(locale, "contact.email");
const emailAddress = getTranslation(locale, "contact.emailAddress");
const linkedinLabel = getTranslation(locale, "contact.linkedin");
const linkedinUrl = getTranslation(locale, "contact.linkedinUrl");
---

<article>
	<h1>{name}</h1>
	<img
		src="/main.jpg"
		alt={`Photograph of ${name}`}
		width="300"
		height="300"
	/>
	<p>{identity}</p>
	<ul>
		<li><a href={`mailto:${emailAddress}`}>{emailLabel}</a></li>
		<li><a href={linkedinUrl} rel="noopener noreferrer" target="_blank">{linkedinLabel}</a></li>
	</ul>
</article>
