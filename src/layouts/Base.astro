---
import "../styles/global.css";
import { getTranslation } from "../lib/i18n";

interface Props {
  locale: string;
  title: string;
  alternateLocale: string;
  alternateUrl: string;
}

const { locale, title, alternateLocale, alternateUrl } = Astro.props;
const toggleLabel = getTranslation(locale, "languageToggle");
const description = getTranslation(locale, "meta.description");
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://jpasse.com",
).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL("/main.jpg", Astro.site ?? "https://jpasse.com").href}
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_CA" : "en_CA"} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang={alternateLocale}
      href={new URL(alternateUrl, Astro.site ?? "https://jpasse.com").href}
    />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={alternateUrl} hreflang={alternateLocale}>
          {toggleLabel}
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
